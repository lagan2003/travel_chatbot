# ─── LLM ───
# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── External APIs ─── (optional — service falls back to mocks if missing)
# AviationStack: https://aviationstack.com/  (free tier: 500 req/mo)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# Hotels: RapidAPI key for hotels-com-provider (or set to "mock")
HOTEL_API_KEY=your_hotel_api_key

# Weather: OpenWeatherMap key (the project still calls the env var
# GOOGLE_WEATHER_API_KEY for backwards compat — value goes to OpenWeather)
GOOGLE_WEATHER_API_KEY=your_openweather_api_key

# ─── Backend ───
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── Caching ───
CACHE_TTL_SECONDS=900

# ─── Storage ───
# Where to store saved trips (json file)
TRIPS_STORE_PATH=./saved_trips.json
